---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

interface Props {
  title: string;
  description: string;
  github: string;
  tags: string[];
}

const { title, description, github, tags } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<article class="border border-border rounded-lg p-6 hover:border-black transition-colors">
  <h3 class="text-lg font-semibold mb-2">{title}</h3>
  <p class="text-muted text-sm mb-4">{description}</p>
  <div class="flex items-center justify-between">
    <div class="flex gap-2">
      {tags.map((tag) => (
        <span class="text-xs border border-border rounded px-2 py-0.5 text-muted">
          {tag}
        </span>
      ))}
    </div>
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm font-medium hover:text-muted"
    >
      {t("projects.viewOnGithub")} &rarr;
    </a>
  </div>
</article>
