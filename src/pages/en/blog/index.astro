---
import Base from "../../../layouts/Base.astro";
import BlogCard from "../../../components/BlogCard.astro";
import { useTranslations, getLocalePath } from "../../../i18n/utils";
import { getCollection } from "astro:content";

const lang = "en";
const t = useTranslations(lang);

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.id.startsWith("en/"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title={t("blog.title")} description={t("blog.description")}>
  <section class="max-w-4xl mx-auto px-6 py-16">
    <div class="animate-fade-in">
      <h1 class="text-3xl font-bold tracking-tight mb-2">{t("blog.title")}</h1>
      <p class="text-muted mb-8">{t("blog.description")}</p>
      <div class="grid gap-6">
        {posts.map((post) => {
          const slug = post.id.replace("en/", "");
          return (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={getLocalePath(lang, `blog/${slug}`)}
            />
          );
        })}
      </div>
    </div>
  </section>
</Base>
