---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";
import { getLocalePath } from "../../i18n/utils";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => p.id.startsWith("kaa/"))
    .map((post) => ({
      params: { slug: post.id.replace("kaa/", "") },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const lang = "kaa";

const formattedDate = post.data.date.toLocaleDateString("uz", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Base title={post.data.title} description={post.data.description}>
  <article class="max-w-3xl mx-auto px-6 py-16">
    <div class="animate-fade-in">
      <a href={getLocalePath(lang, "blog")} class="text-sm text-muted hover:text-black mb-8 inline-block">
        &larr; Blog
      </a>
      <header class="mb-8">
        <time class="text-sm text-muted">{formattedDate}</time>
        <h1 class="text-3xl font-bold tracking-tight mt-2">{post.data.title}</h1>
        <p class="text-muted mt-2">{post.data.description}</p>
      </header>
      <div class="prose prose-neutral max-w-none [&>h2]:text-xl [&>h2]:font-semibold [&>h2]:mt-8 [&>h2]:mb-3 [&>p]:text-muted [&>p]:leading-relaxed [&>p]:mb-4">
        <Content />
      </div>
    </div>
  </article>
</Base>
